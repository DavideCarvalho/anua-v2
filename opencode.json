{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-cursor-oauth", "opencode-gemini-auth@latest"],
  "provider": {
    "cursor": {
      "name": "Cursor"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", ".next/**", ".turbo/**", "dist/**", "build/**", "coverage/**"]
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp",
      "enabled": true
    }
  }
}
